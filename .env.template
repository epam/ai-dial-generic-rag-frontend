# Copy to .env.local and fill in values as environment variables are introduced.

# Origin(s) allowed to frame this app via CSP `frame-ancestors` (e.g. the deployed DIAL Admin
# origin). Required for iframe embedding — defaults to 'none' (refuses to be framed).
ALLOWED_FRAME_ANCESTORS=

# DIAL Admin origin, used as a fallback to resolve the embedding parent when
# window.location.ancestorOrigins/document.referrer are unavailable (e.g. local dev). Read
# server-side and passed to the client via EmbeddingContext, not exposed as NEXT_PUBLIC_*.
DIAL_ADMIN_URL=

# Visualizer name used to namespace postMessage events with DIAL Admin when the `id` query
# param isn't present. Read server-side and passed to the client via EmbeddingContext, not
# exposed as NEXT_PUBLIC_*.
DIAL_APPLICATION_NAME=

# Base origin of DIAL Core, used to reach the channel API through its deployment route
# (/v1/deployments/{application_id}/route/channel/**).
DIAL_API_URL=

# --- Authentication ---
# Auth is disabled entirely unless NEXTAUTH_URL is set. Fill in NEXTAUTH_URL/NEXTAUTH_SECRET plus
# exactly one identity provider's block below. See docs/authentication.md for full details.

# Canonical URL of this deployment, used by NextAuth for callback URLs and to detect https
# (secure cookies). Presence of this var is what turns auth on/off.
NEXTAUTH_URL=

# Secret NextAuth uses to sign/encrypt session JWTs. Required whenever NEXTAUTH_URL is set.
NEXTAUTH_SECRET=

# Comma-separated role names that grant admin access (default: "admin").
ADMIN_ROLE_NAMES=

# JWT claim path (dot-separated) the user's roles are read from (default: "dial_roles").
DIAL_ROLES_FIELD=

# Set to "true" to log the token `sub` claim in the clear (debug only; masked by default).
SHOW_TOKEN_SUB=

# --- Keycloak ---
AUTH_KEYCLOAK_CLIENT_ID=
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_HOST=
# Optional: if set, issuer becomes "<HOST>/realms/<REALM>" instead of just HOST.
AUTH_KEYCLOAK_REALM=
# Optional, default: "SSO".
AUTH_KEYCLOAK_NAME=
# Optional, default: "openid email profile offline_access".
AUTH_KEYCLOAK_SCOPE=

# --- Azure AD ---
AUTH_AZURE_AD_CLIENT_ID=
AUTH_AZURE_AD_SECRET=
AUTH_AZURE_AD_TENANT_ID=
# Optional, default: "SSO".
AUTH_AZURE_AD_NAME=
# Optional, default: "openid profile user.Read email offline_access".
AUTH_AZURE_AD_SCOPE=

# --- Google ---
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_SECRET=
# Optional, default: "SSO".
AUTH_GOOGLE_NAME=
# Optional, default: "openid email profile offline_access".
AUTH_GOOGLE_SCOPE=

# --- Auth0 ---
AUTH_AUTH0_CLIENT_ID=
AUTH_AUTH0_SECRET=
AUTH_AUTH0_HOST=
# Optional, default: "SSO".
AUTH_AUTH0_NAME=
# Optional: API audience, unset by default.
AUTH_AUTH0_AUDIENCE=
# Optional, default: "openid email profile offline_access".
AUTH_AUTH0_SCOPE=

# --- Amazon Cognito ---
AUTH_COGNITO_CLIENT_ID=
AUTH_COGNITO_SECRET=
AUTH_COGNITO_HOST=
# Optional, default: "SSO".
AUTH_COGNITO_NAME=
# Optional, default: "openid email profile".
AUTH_COGNITO_SCOPE=

# --- Okta ---
AUTH_OKTA_CLIENT_ID=
AUTH_OKTA_CLIENT_SECRET=
AUTH_OKTA_ISSUER=
# Optional, default: "openid email profile".
AUTH_OKTA_SCOPE=
